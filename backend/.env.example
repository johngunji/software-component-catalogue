NODE_ENV=development
JWT_SECRET=
CORS_ORIGIN=http://localhost:5500

# Accounts created on first start: "user" and "cataloguer".
# In development the default password is changeme123. In production, set
# both role-specific passwords (or SEED_PASSWORD to use one for both).
SEED_USER_PASSWORD=
SEED_CATALOGUER_PASSWORD=

# DB_PATH=componenthub.db

# Seconds during which a repeated "use" of the same component by the
# same user is counted once (default 30).
# USE_DEDUPE_SECONDS=30
